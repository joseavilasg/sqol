# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
indent_size = 3
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,json,yml,yaml}]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4
