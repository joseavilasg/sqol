# The extension is a Node project, so it does not inherit the Go rules at the
# repository root. Biome reads an .editorconfig only from the folder it treats
# as the project, which is this one.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
